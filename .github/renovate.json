{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "assignees": ["SoWieMarkus"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 8am on friday"],
  "semanticCommits": "disabled",
  "commitMessageAction": "Renovate: Update",
  "labels": ["dependencies"],
  "prConcurrentLimit": 8,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Security fixes skip the release age wait but always need review",
    "minimumReleaseAge": null,
    "automerge": false,
    "labels": ["dependencies", "security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Major updates need explicit approval on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Group Go modules, automerge non-major once CI is green",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules",
      "automerge": true
    },
    {
      "description": "Keep the Go toolchain directive and Docker base image in sync",
      "matchPackageNames": ["go", "golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "Website dev tooling, automerge non-major once CI is green",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "website dev dependencies",
      "automerge": true
    },
    {
      "description": "Website runtime dependencies ship to users and need review",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "website dependencies"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "description": "Actions run with repository secrets: pinned to digests, automerge only non-major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images"
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions in workflows annotated with '# renovate:' comments",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
      ]
    }
  ]
}
