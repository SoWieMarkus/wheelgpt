# Copy to .env. `make up` passes it to the dev stack in dev/.

# Where users open the website. Use http://localhost:5173 with `make website`.
# OAuth redirect URIs and chat links are built from it. Register these
# redirect URLs in the Twitch developer console:
#   PUBLIC_URL/api/v1/auth/twitch/callback
#   PUBLIC_URL/api/v1/auth/bot/callback
PUBLIC_URL=http://localhost:3000

# Optional: Twitch application (https://dev.twitch.tv/console/apps). Without
# it the bot runs offline: no Twitch login, chat replies are only logged.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 10 to 100 characters, signs the EventSub webhooks.
TWITCH_EVENTSUB_SECRET=

# Login of the bot account. It authorizes the app once at PUBLIC_URL/api/v1/auth/bot.
BOT_USERNAME=wheelgpt

# Secret of the old backend's plugin tokens. Keep the production value until
# every streamer created a new token, then remove it.
JWT_SECRET_CHANNEL=

# Local only (needs a localhost PUBLIC_URL): log in without Twitch at
# PUBLIC_URL/api/v1/auth/dev?login=you, and fake being live on the dashboard
# to test the plugin without streaming.
DEV_MODE=true
